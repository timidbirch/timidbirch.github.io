---
import type { PhotoData } from '~/types'
import { cn } from '~/lib/utils'
import PolaroidStack from './PolaroidStack'
import TimelineIcon from './TimelineIcon.astro'

interface Props {
  photoData: PhotoData[]
  class?: string
  en?: boolean
}

const { photoData, class: className, en = false } = Astro.props
---

<div class={cn(className)}>
  {
    photoData.map((timeline, index) => {
      const title = en ? timeline.title : timeline.titleZh
      const description = en ? timeline.description : timeline.descriptionZh
      const photos = en ? timeline.photos : timeline.photos.map((photo) => ({ ...photo, alt: title }))
      return (
        <div id={timeline.id} class="timeline-item relative group/item">
          <div class="flex gap-x-3">
            <div class="relative last:after:hidden after:absolute after:top-7 after:bottom-0 after:start-3.5 after:w-px after:-translate-x-[0.5px] after:bg-zinc-200/50 dark:after:bg-zinc-700/50">
              <div class="relative z-10 size-7 flex justify-center items-center">
                <TimelineIcon icon={timeline.icon} index={index} />
              </div>
            </div>
            <div class="grow pt-0.5 pb-8 relative">
              <time datetime={timeline.date} class="text-xs block mt-1 sm:absolute sm:mt-0 sm:top-1.5 right-0 text-muted-foreground">
                {timeline.date}
              </time>
              <h2 class="mt-0.5 sm:mt-0 font-sans text-md font-normal!">
                <span class="font-semibold">{title}</span>
              </h2>
              <p class="mt-0.5 sm:mt-1 text-sm text-muted-foreground">
                {description && (
                  <span>
                    {description}
                    <br />
                  </span>
                )}
              </p>
              <div class="mt-4 py-2 sm:py-4">
                <PolaroidStack {photos} {title} {description} client:visible />
              </div>
            </div>
          </div>
        </div>
      )
    })
  }
</div>
