---
import Layout from '~/layouts/Layout.astro'
import { getAllPosts } from '~/lib/data'
import { BLOG_CATEGORIES, getBlogCategory, postsInCategory, type BlogCategoryId } from '~/lib/blog-categories'

interface Props {
  en?: boolean
  categoryId?: BlogCategoryId
}
const { en = false, categoryId } = Astro.props
const posts = postsInCategory(await getAllPosts(), categoryId)
const active = BLOG_CATEGORIES.find((category) => category.id === categoryId)
const prefix = en ? '/en' : ''
const title = active ? (en ? active.nameEn : active.name) : en ? 'Posts' : '文章'
const description = active
  ? en
    ? active.descriptionEn
    : active.description
  : en
    ? 'Notes on technology, markets, and what I’m learning.'
    : '记录技术探索、市场观察与学习过程中的思考。'
const tags = [...new Set(posts.flatMap((post) => post.data.tags || []))].sort()
---

<Layout {title} {description}>
  <section class="paper-list" data-blog>
    <h1 class="paper-title">{title}</h1><p class="paper-intro">{description}</p>
    <nav class="paper-chips archive-chapters" aria-label={en ? 'Post categories' : '文章分类'}>
      <a href={prefix + '/blog'} aria-current={!categoryId ? 'page' : undefined}>{en ? 'All posts' : '全部文章'}</a>
      {
        BLOG_CATEGORIES.map((category) => (
          <a href={`${prefix}/blog/category/${category.id}`} aria-current={categoryId === category.id ? 'page' : undefined}>
            {en ? category.nameEn : category.name}
          </a>
        ))
      }
    </nav>
    {
      posts.length ? (
        <>
          <div class="archive-search">
            <label>
              <>
                <span class="sr-only">{en ? 'Search posts' : '搜索文章'}</span>
                <input type="search" placeholder={en ? 'Search posts…' : '搜索文章…'} data-blog-search autocomplete="off" />
              </>
            </label>
            <span data-blog-count data-unit={en ? 'posts' : '篇文章'} data-unit-one={en ? 'post' : '篇文章'} aria-live="polite" />
            <a class="text-link" href="/rss.xml">
              RSS ↗
            </a>
          </div>
          {tags.length > 0 && (
            <div class="paper-chips" role="group" aria-label={en ? 'Filter by tag' : '按标签筛选'}>
              <button type="button" data-blog-tag="" aria-pressed="true">
                {en ? 'All tags' : '全部标签'}
              </button>
              {tags.map((tag) => (
                <button type="button" data-blog-tag={tag} aria-pressed="false">
                  {tag}
                </button>
              ))}
            </div>
          )}
          <div class="post-index">
            {posts.map(({ id, data }) => {
              const category = getBlogCategory(data.category)
              return (
                <a
                  class="paper-row"
                  href={`${prefix}/blog/${id}`}
                  data-blog-card
                  data-search={`${data.title} ${data.description} ${(data.tags || []).join(' ')}`}
                  data-tags={JSON.stringify(data.tags || [])}
                >
                  <div class="paper-row-top">
                    <h2 lang={data.language === 'zh' ? 'zh-CN' : 'en'}>{data.title}</h2>
                    <time datetime={data.pubDate.toISOString()}>{data.pubDate.toISOString().slice(0, 10)}</time>
                  </div>
                  <p lang={data.language === 'zh' ? 'zh-CN' : 'en'}>{data.description}</p>
                  <small>{en ? category.nameEn : category.name}</small>
                </a>
              )
            })}
          </div>
          <p class="paper-intro" data-blog-no-results hidden>
            {en ? 'No matching posts.' : '没有符合条件的文章。'}
          </p>
        </>
      ) : (
        <p class="paper-intro">{en ? 'There are no posts in this collection yet.' : '这里暂时还没有文章。'}</p>
      )
    }
  </section>
</Layout>

<script>
  import '~/scripts/blog'
</script>
