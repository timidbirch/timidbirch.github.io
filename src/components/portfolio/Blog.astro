---
import Layout from '~/layouts/Layout.astro'
import { getAllPosts } from '~/lib/data'
import { BLOG_CATEGORIES, getBlogCategory, postsInCategory, type BlogCategoryId } from '~/lib/blog-categories'
import '~/styles/blog.css'
interface Props {
  en?: boolean
  categoryId?: BlogCategoryId
}
const { en = false, categoryId } = Astro.props
const allPosts = await getAllPosts()
const posts = postsInCategory(allPosts, categoryId)
const activeCategory = BLOG_CATEGORIES.find((category) => category.id === categoryId)
const categoryName = activeCategory && (en ? activeCategory.nameEn : activeCategory.name)
const tags = [...new Set(posts.flatMap((post) => post.data.tags || []))].sort()
const prefix = en ? '/en' : ''
---

<Layout
  title={categoryName || (en ? 'Blog' : '个人博客')}
  description={activeCategory
    ? en
      ? activeCategory.descriptionEn
      : activeCategory.description
    : en
      ? 'Notes on technology, markets, and the things I am learning.'
      : '记录技术探索、市场观察与学习过程中的思考。'}
>
  <section class="portfolio-section listing-section blog-section" data-blog>
    <div class="section-heading reveal">
      <div>
        <p class="eyebrow">FIELD NOTES / {activeCategory?.code || String(posts.length).padStart(2, '0')}</p><h1>
          {categoryName || (en ? 'A place to think' : '把思考，')}<br /><span
            >{activeCategory ? (en ? 'A closer look.' : '在探索中，沉淀。') : en ? 'out loud.' : '慢慢写下来。'}</span
          >
        </h1>
      </div>
      <p class="section-lede">
        {
          activeCategory
            ? en
              ? activeCategory.descriptionEn
              : activeCategory.description
            : en
              ? 'Between building things and understanding them. Notes on technology, markets, and what I learn along the way.'
              : '在动手构建与理解世界之间，记录技术探索、市场观察，以及学习途中值得留下的想法。'
        }
      </p>
    </div>
    <nav class="blog-categories" aria-label={en ? 'Blog sections' : '博客板块'}>
      {
        BLOG_CATEGORIES.map((category, index) => {
          const count = postsInCategory(allPosts, category.id).length
          return (
            <a
              class="blog-category glass reveal"
              href={`${prefix}/blog/category/${category.id}`}
              aria-current={categoryId === category.id ? 'page' : undefined}
            >
              <div class="card-topline">
                <>
                  <span>
                    0{index + 1} / {category.code}
                  </span>
                  <span class="category-icon" aria-hidden="true">
                    {category.icon}
                  </span>
                </>
              </div>
              <h2>{en ? category.nameEn : category.name}</h2>
              <p>{en ? category.descriptionEn : category.description}</p>
              <div class="category-foot">
                <>
                  <span>
                    {count} {en ? (count === 1 ? 'note' : 'notes') : '篇文章'}
                  </span>
                  <span aria-hidden="true">↗</span>
                </>
              </div>
            </a>
          )
        })
      }
    </nav>
    <div class="blog-list-heading">
      <h2>{categoryName || (en ? 'All notes' : '全部文章')}</h2>{
        activeCategory ? (
          <a class="text-link" href={`${prefix}/blog`}>
            ← {en ? 'All sections' : '全部板块'}
          </a>
        ) : (
          <span>{en ? 'The latest from every section' : '各板块最新文章'}</span>
        )
      }
    </div>
    <div class="blog-toolbar reveal">
      <label class="blog-search glass"
        ><span class="icon-[ri--search-line]" aria-hidden="true"></span><span class="sr-only">{en ? 'Search notes' : '搜索文章'}</span
        ><input type="search" placeholder={en ? 'Find a thought…' : '搜索标题、摘要或标签…'} data-blog-search autocomplete="off" /></label
      >
      <span class="blog-count" data-blog-count data-unit={en ? 'notes' : '篇文章'} data-unit-one={en ? 'note' : '篇文章'} aria-live="polite"
        >{posts.length} {en ? (posts.length === 1 ? 'note' : 'notes') : '篇文章'}</span
      >
      {
        posts.length > 0 && (
          <a class="text-link" href="/rss.xml">
            RSS ↗
          </a>
        )
      }
    </div>
    {
      tags.length > 0 && (
        <div class="blog-filters" role="group" aria-label={en ? 'Filter by tag' : '按标签筛选'}>
          <button type="button" data-blog-tag="" aria-pressed="true">
            {en ? 'All notes' : '全部文章'}
          </button>
          {tags.map((tag) => (
            <button type="button" data-blog-tag={tag} aria-pressed="false">
              {tag}
            </button>
          ))}
        </div>
      )
    }
    {
      posts.length > 0 ? (
        <div class="blog-grid">
          {posts.map((post, index) => (
            <a
              class="blog-card glass reveal"
              href={`${prefix}/blog/${post.id}`}
              data-blog-card
              data-search={`${post.data.title} ${post.data.description} ${(post.data.tags || []).join(' ')}`}
              data-tags={JSON.stringify(post.data.tags || [])}
            >
              <div class="card-topline">
                <span>
                  {String(index + 1).padStart(2, '0')} /{' '}
                  {en ? getBlogCategory(post.data.category).nameEn : getBlogCategory(post.data.category).name}
                </span>
                <time datetime={post.data.pubDate.toISOString()}>{post.data.pubDate.toISOString().slice(0, 10)}</time>
              </div>
              <h2>{post.data.title}</h2>
              <p class="card-summary">{post.data.description}</p>
              <div class="card-tags">
                {post.data.tags?.map((tag) => (
                  <span>{tag}</span>
                ))}
              </div>
              <span class="card-read">
                {en ? 'Read the note' : '阅读全文'} <span aria-hidden="true">↗</span>
              </span>
            </a>
          ))}
        </div>
      ) : (
        <div class:list={['blog-empty glass reveal', { 'blog-empty-category': activeCategory }]}>
          <div class="notebook-art" aria-hidden="true">
            <>
              <span class="notebook-orbit" />
              <div class="notebook-page">
                <>
                  <span>FIELD NOTES</span>
                  <i />
                  <i />
                  <i />
                  <b>✳</b>
                  <small>CHEN / PEIHUA</small>
                </>
              </div>
              <span class="notebook-spark">+</span>
            </>
          </div>
          <div class="blog-empty-copy">
            <>
              <p class="eyebrow">A NOTEBOOK, IN THE MAKING</p>
              <h2>
                {activeCategory
                  ? en
                    ? 'This chapter is still being written.'
                    : '这一页，正在酝酿。'
                  : en
                    ? 'Good thoughts take time.'
                    : '好想法，值得整理。'}
              </h2>
              <p>
                {activeCategory
                  ? en
                    ? `Notes on ${activeCategory.nameEn.toLowerCase()} will appear here when they are ready to share.`
                    : `关于「${activeCategory.name}」的文章还在整理中，准备好后会在这里与你分享。`
                  : en
                    ? 'This is where my notes will become essays. The first entries are still being put together — see you here soon.'
                    : '这里将收录从个人笔记中整理出的文章。第一批内容还在酝酿中，等想法成熟，再与你分享。'}
              </p>
              <a class="text-link" href={`${prefix}/projects`}>
                {en ? 'Explore my projects in the meantime' : '先看看我在做的项目'} ↗
              </a>
            </>
          </div>
        </div>
      )
    }
    <p class="blog-no-results" data-blog-no-results hidden>
      {en ? 'No matching notes. Try another word or tag.' : '没有匹配的文章，试试其他关键词或标签。'}
    </p>
    <div class="blog-colophon">
      <span>THINK / WRITE / CONNECT</span><span>{en ? 'A personal notebook by CHEN Peihua' : '陈佩桦的个人思考笔记'}</span>
    </div>
  </section>
</Layout>
<script>
  import '~/scripts/blog'
</script>
