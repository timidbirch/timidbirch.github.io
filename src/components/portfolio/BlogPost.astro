---
import { render, type CollectionEntry } from 'astro:content'
import Layout from '~/layouts/Layout.astro'
import Prose from '~/components/posts/base/Prose.astro'
import License from '~/components/posts/base/License.astro'
import Comment from '~/components/posts/base/Comment.astro'
import { getAllPosts } from '~/lib/data'
import { getBlogCategory } from '~/lib/blog-categories'
import { SITE } from '~/config'

interface Props {
  post: CollectionEntry<'posts'>
  en?: boolean
}
const { post, en = false } = Astro.props
const { Content, headings } = await render(post)
const posts = await getAllPosts()
const index = posts.findIndex((item) => item.id === post.id)
const neighbors = [
  { post: posts[index + 1], label: en ? '← Older post' : '← 上一篇' },
  { post: posts[index - 1], label: en ? 'Newer post →' : '下一篇 →' },
]
const prefix = en ? '/en' : ''
const category = getBlogCategory(post.data.category)
const language = post.data.language === 'zh' ? 'zh-CN' : 'en'
const toc = headings.filter((heading) => heading.depth <= 3 && heading.slug !== 'footnote-label')
const date = (value: Date) => value.toISOString().slice(0, 10)
---

<Layout title={post.data.title} description={post.data.description} image={post.data.ogImage?.src}>
  <article class="paper-article" data-reading>
    <header class="reading-header">
      <nav class="reading-breadcrumb" aria-label={en ? 'Article navigation' : '文章导航'}>
        <a class="text-link" href={`${prefix}/blog`}>{en ? '← All posts' : '← 全部文章'}</a>
        <a class="text-link" href={`${prefix}/blog/category/${category.id}`}>{en ? category.nameEn : category.name}</a>
      </nav>
      <h1 lang={language}>{post.data.title}</h1>
      <div class="reading-meta">
        <time datetime={post.data.pubDate.toISOString()}>{date(post.data.pubDate)}</time>
        {
          post.data.updatedDate && (
            <span>
              {en ? 'Updated' : '更新于'} {date(post.data.updatedDate)}
            </span>
          )
        }
        {post.data.tags?.map((tag) => <span>{tag}</span>)}
      </div>
    </header>
    {
      toc.length > 0 && (
        <aside class="reading-aside">
          <details open>
            <summary>{en ? 'On this page' : '文章目录'}</summary>
            <nav aria-label={en ? 'Table of contents' : '文章目录'}>
              {toc.map((heading) => (
                <a
                  class:list={{ 'toc-subheading': heading.depth === 3 }}
                  href={`#${encodeURIComponent(heading.slug)}`}
                  data-heading-id={heading.slug}
                >
                  {heading.text.replace(new RegExp(`h${heading.depth}$`), '')}
                </a>
              ))}
            </nav>
          </details>
          <p class="reading-progress">
            <>
              <progress max="100" value="0" aria-label={en ? 'Reading progress' : '阅读进度'} />
              <span aria-hidden="true">0%</span>
            </>
          </p>
        </aside>
      )
    }
    <div class="reading-content">
      <p class="reading-summary" lang={language}>{post.data.description}</p>
      <div data-reading-body lang={language}><Prose><Content /></Prose></div>
      {post.data.license && <License license={post.data.license} title={post.data.title} author={post.data.author || SITE.author} />}
      <nav class="reading-neighbors" aria-label={en ? 'More posts' : '继续阅读'}>
        {
          neighbors.map(
            (item) =>
              item.post && (
                <a href={`${prefix}/blog/${item.post.id}`}>
                  <>
                    <small>{item.label}</small>
                    <span>{item.post.data.title}</span>
                  </>
                </a>
              )
          )
        }
      </nav>
      <Comment id={post.id} title={post.data.title} />
    </div>
  </article>
</Layout>

<script>
  let controller: AbortController | undefined
  document.addEventListener('astro:page-load', () => {
    controller?.abort()
    const body = document.querySelector<HTMLElement>('[data-reading-body]')
    const progress = document.querySelector<HTMLProgressElement>('.reading-progress progress')
    if (!body || !progress) return
    controller = new AbortController()
    const { signal } = controller
    const sections = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-heading-id]')).flatMap((link) => {
      const heading = document.getElementById(link.dataset.headingId ?? '')
      return heading && body.contains(heading) ? [{ link, heading }] : []
    })
    let activeLink: HTMLAnchorElement | undefined
    let frame = 0
    const update = () => {
      frame = 0
      const rect = body.getBoundingClientRect()
      const line = Math.min(innerHeight * 0.68, rect.height)
      const value = Math.round(100 * Math.min(1, Math.max(0, (line - rect.top) / rect.height)))
      progress.value = value
      if (progress.nextElementSibling) progress.nextElementSibling.textContent = `${value}%`

      const headingLine = Math.min(innerHeight * 0.42, 240)
      let nextLink = sections[0]?.link
      for (const section of sections) {
        if (section.heading.getBoundingClientRect().top > headingLine) break
        nextLink = section.link
      }
      if (nextLink !== activeLink) {
        activeLink?.removeAttribute('aria-current')
        nextLink?.setAttribute('aria-current', 'location')
        activeLink = nextLink
      }
    }
    const scheduleUpdate = () => {
      if (!frame) frame = requestAnimationFrame(update)
    }
    const observer = new ResizeObserver(scheduleUpdate)
    observer.observe(body)
    signal.addEventListener(
      'abort',
      () => {
        observer.disconnect()
        cancelAnimationFrame(frame)
      },
      { once: true }
    )
    addEventListener('scroll', scheduleUpdate, { passive: true, signal })
    addEventListener('resize', scheduleUpdate, { signal })
    update()
  })
  document.addEventListener('astro:before-swap', () => controller?.abort())
</script>

<style>
  .paper-article {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 175px;
    gap: 28px 48px;
    max-width: 940px;
    margin-inline: auto;
  }
  .reading-breadcrumb {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 14px;
    color: var(--soft-ink);
    font: 400 var(--type-label) / 1.5 var(--font-sans);
    letter-spacing: 0.02em;
  }
  .reading-breadcrumb a + a {
    padding-inline-start: 14px;
    border-inline-start: 1px solid var(--line);
    color: var(--soft-ink);
  }
  .reading-breadcrumb a + a:hover {
    color: var(--signal);
  }
  .reading-header {
    grid-column: 1;
  }
  .reading-header h1 {
    margin-top: 18px;
    text-align: center;
    font-family: var(--space-serif);
    font-size: clamp(2rem, 3.6vw, 2.6rem);
    font-weight: 500;
    font-synthesis: none;
    line-height: 1.2;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  .reading-meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 5px 12px;
    margin-top: 14px;
    color: var(--soft-ink);
    font: 400 var(--type-label) / 1.5 var(--font-sans);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.03em;
  }
  .reading-aside {
    grid-column: 2;
    grid-row: 2;
    position: sticky;
    align-self: start;
    top: 89px;
    color: var(--soft-ink);
    font: 400 var(--type-label) / 1.6 var(--font-sans);
  }
  .reading-aside summary {
    cursor: pointer;
    margin-bottom: 8px;
    color: var(--color-foreground);
    font-weight: 500;
  }
  .reading-aside nav {
    max-height: min(55vh, 450px);
    overflow: auto;
    scrollbar-width: thin;
  }
  .reading-aside nav a {
    display: block;
    padding: 5px 7px;
    border-inline-start: 2px solid transparent;
    transition:
      color var(--space-hover-duration) ease,
      background-color var(--space-hover-duration) ease;
  }
  .reading-aside nav a:is(:hover, :focus-visible, [aria-current]) {
    color: var(--signal);
  }
  .reading-aside nav a[aria-current] {
    border-inline-start-color: var(--signal);
    background: color-mix(in srgb, var(--signal) 9%, transparent);
  }
  .reading-aside .toc-subheading {
    padding-inline-start: 17px;
  }
  .reading-progress {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 14px;
  }
  .reading-progress progress {
    width: 85px;
    height: 6px;
    accent-color: var(--signal);
  }
  .reading-content {
    grid-column: 1;
    grid-row: 2;
    min-width: 0;
  }
  .reading-summary {
    border: 1px solid var(--line);
    border-inline-start: 3px solid var(--signal);
    background: var(--paper-panel);
    padding: 16px 20px;
    margin-bottom: 28px;
    font: 400 var(--type-copy) / 1.8 var(--font-sans);
    letter-spacing: 0.01em;
  }
  .reading-neighbors {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 20px;
    margin-top: 40px;
    border-top: 1px solid var(--line);
    padding-top: 20px;
  }
  .reading-neighbors small {
    display: block;
    color: var(--soft-ink);
    font: 400 var(--type-label) / 1.5 var(--font-sans);
    letter-spacing: 0.04em;
  }
  .reading-neighbors a {
    font-size: var(--type-copy);
    line-height: 1.6;
  }
  .reading-neighbors a:hover {
    color: var(--signal);
  }
  @media (max-width: 820px) {
    .paper-article {
      display: block;
    }
    .reading-aside {
      position: static;
      margin-block: 23px;
    }
    .reading-content {
      margin-top: 20px;
    }
  }
</style>
