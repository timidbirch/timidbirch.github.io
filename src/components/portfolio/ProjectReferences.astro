---
import type { CollectionEntry } from 'astro:content'

type Props = { references: CollectionEntry<'projects'>['data']['references']; en?: boolean }
const { references, en = false } = Astro.props
---

{
  references.length > 0 && (
    <section class="px-6 sm:px-8 pb-10 sm:pb-14" aria-labelledby="project-references-title">
      <h2 id="project-references-title" class="text-2xl tracking-tight mb-4">
        {en ? 'References and foundations' : '参考与开源基础'}
      </h2>
      <ul class="space-y-3 text-muted-foreground">
        {references.map((reference) => (
          <li>
            <a href={reference.url} target="_blank" rel="noreferrer" class="hover:text-primary underline underline-offset-4">
              {en ? reference.labelEn : reference.label} ↗
            </a>
          </li>
        ))}
      </ul>
    </section>
  )
}
