---
import Layout from '~/layouts/Layout.astro'
import { getAllExperiences } from '~/lib/data'
const { en = false } = Astro.props
const experiences = await getAllExperiences()
const title = en ? 'Experience' : '实践经历'
const prefix = en ? '/en' : ''
---

<Layout {title} description={en ? 'Work and research experience.' : '工作与研究经历。'}>
  <section class="paper-list">
    <h1 class="paper-title">{title}</h1>
    <div class="mt-8">
      {
        experiences.map(({ id, data }) => (
          <a class="paper-row" href={`${prefix}/experience/${id}`}>
            <div class="paper-row-top">
              <>
                <h2>{en ? data.companyEn || data.company : data.company}</h2>
                <small>{data.period}</small>
              </>
            </div>
            <p>{en ? data.roleEn : data.role}</p>
            <p>{en ? data.summaryEn : data.summary}</p>
          </a>
        ))
      }
    </div>
  </section>
</Layout>
