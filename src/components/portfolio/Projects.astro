---
import ProjectCards from './ProjectCards.astro'
import Layout from '~/layouts/Layout.astro'
import { getAllProjects } from '~/lib/data'
const { en = false } = Astro.props
const projects = await getAllProjects()
---
<Layout title={en ? 'Projects' : '项目'} description={en ? 'Technical projects by CHEN Peihua.' : '陈佩桦的技术研究与项目。'}>
  <section class="portfolio-section listing-section">
    <div class="section-heading reveal"><div><p class="eyebrow">PROJECTS & STUDIES / {String(projects.length).padStart(2, '0')}</p><h1>{en ? 'Ideas, made' : '让想法，'}<br /><span>{en ? 'into something real.' : '成为真实。'}</span></h1></div><p class="section-lede">{en ? 'Try a shuttle reservation, compare real experiment images, or follow a fuzz driver through the source. Explore each project through interfaces, artifacts, and interactive walkthroughs.' : '预约一趟班车，对比真实实验图像，或跟随一个测试驱动的生成过程。通过界面、材料与交互导览，走近每个项目。'}</p></div>
    <ProjectCards {projects} {en} />
  </section>
</Layout>
