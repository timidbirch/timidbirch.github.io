---
import Layout from '~/layouts/Layout.astro'
import { getAllProjects } from '~/lib/data'
const { en = false } = Astro.props
const projects = await getAllProjects()
const title = en ? 'Projects' : '项目'
const prefix = en ? '/en' : ''
---

<Layout {title} description={en ? 'Research and projects by timidbirch.' : 'timidbirch的研究与项目。'}>
  <section class="project-index">
    <div class="project-index-heading">
      <h1 class="eyebrow">{title}</h1><a class="text-link" href="https://github.com/timidbirch">github.com/timidbirch ↗</a>
    </div>
    <div class="project-index-grid">
      {
        projects.map(({ id, data }) => (
          <a class="paper-row" href={`${prefix}/projects/${id}`}>
            <div class="paper-row-top">
              <h2>{en ? data.nameEn : data.name}</h2>
              {data.year && <small>{data.year}</small>}
            </div>
            <p>{en ? data.descriptionEn : data.description}</p>
          </a>
        ))
      }
    </div>
  </section>
</Layout>

<style>
  .project-index {
    max-width: 940px;
    margin-inline: auto;
    font-family: var(--space-typewriter), var(--font-sans);
  }
  .project-index-heading {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin-bottom: 20px;
  }
  .project-index-heading .text-link {
    color: var(--soft-ink);
  }
  .project-index-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 40px;
  }
  .project-index .paper-row p {
    color: var(--soft-ink);
  }
  .project-index h2 {
    font-family: var(--space-serif);
  }
  .project-index .paper-row {
    border-radius: 5px;
  }
  .project-index .paper-row:is(:hover, :focus-visible) {
    background: color-mix(in srgb, var(--signal) 5%, transparent);
  }
  @media (max-width: 620px) {
    .project-index-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
