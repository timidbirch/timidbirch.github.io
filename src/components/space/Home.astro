---
import { SITE } from '~/config'
import { Image } from 'astro:assets'
import Avatar from './Avatar.astro'
import Layout from '~/layouts/Layout.astro'
import { getAllPosts, getAllProjects } from '~/lib/data'
import { getBlogCategory } from '~/lib/blog-categories'
import { photoAlbums } from '~/lib/photos'
import '~/styles/space-home.css'
const { en = false } = Astro.props
const prefix = en ? '/en' : ''
const [posts, projects] = await Promise.all([getAllPosts(), getAllProjects()])
const featured = ['holdem', 'ragfuzz', 'ncc-bus'].flatMap((id) => projects.filter((project) => project.id === id))
const [latest, ...otherPosts] = posts.slice(0, 5)
const [album] = photoAlbums
const date = new Intl.DateTimeFormat(en ? 'en-GB' : 'zh-CN', { month: 'short', day: 'numeric', timeZone: 'UTC' })
const description = en
  ? 'A record of what I think about, create, and explore, and the fragments that defy categorization.'
  : '这里记录我的思考、创造、探索，以及那些无法被归类的片段'
const socials = [
  { href: '/rss.xml', label: 'RSS', icon: 'icon-[ri--rss-line]' },
  { href: 'mailto:1146816430@qq.com', label: en ? 'Email' : '邮件', icon: 'icon-[ri--mail-line]' },
  { href: 'https://github.com/timidbirch', label: 'GitHub', icon: 'icon-[ri--github-line]' },
]
---

<Layout title={en ? 'Home' : '首页'} {description}>
  <div class="guest-home">
    <section class="space-hero" aria-labelledby="space-title">
      <div class="space-hello">
        <Avatar class="hero-avatar" />
        <p class="hero-byline">{SITE.title}</p>
        <h1 id="space-title" lang="en">A Life in <em>Draft</em></h1>
        <p class="hero-context">{description}</p>
      </div>
      <div class="space-hero-foot">
        <div class="hero-stats">
          <a href={prefix + '/blog'}>{posts.length} {en ? 'posts' : '篇文章'}</a>
          <span aria-hidden="true">·</span>
          <a href={prefix + '/photos'}>{photoAlbums.length} {en ? 'albums' : '组照片'}</a>
        </div>
        <div class="hero-socials">
          {
            socials.map((item) => (
              <a href={item.href} aria-label={item.label} title={item.label}>
                <span aria-hidden="true" class={item.icon} />
              </a>
            ))
          }
        </div>
      </div>
      <a class="hero-down" href="#home-reading" aria-label={en ? 'Explore recent writing' : '浏览近期笔墨'}>↓</a>
    </section>

    <div class="home-digest" id="home-reading">
      <section aria-labelledby="writing-title">
        <div class="home-section-heading">
          <h2 id="writing-title">{en ? 'Recent Writing' : '近期笔墨'}</h2><a href={prefix + '/blog'}>{en ? 'All posts' : '全部文章'} ↗</a>
        </div>
        {
          latest && (
            <a class="lead-writing" href={`${prefix}/blog/${latest.id}`}>
              <span>
                {en ? 'Post' : '文章'} · <time datetime={latest.data.pubDate.toISOString()}>{date.format(latest.data.pubDate)}</time>
              </span>
              <h3 lang={latest.data.language === 'zh' ? 'zh-CN' : 'en'}>{latest.data.title}</h3>
              <p>{latest.data.description}</p>
            </a>
          )
        }
        {
          otherPosts.map((post) => (
            <a class="digest-row" href={`${prefix}/blog/${post.id}`}>
              <div>
                <>
                  <strong lang={post.data.language === 'zh' ? 'zh-CN' : 'en'}>{post.data.title}</strong>
                  <small>{en ? getBlogCategory(post.data.category).nameEn : getBlogCategory(post.data.category).name}</small>
                </>
              </div>
              <time datetime={post.data.pubDate.toISOString()}>{date.format(post.data.pubDate)}</time>
            </a>
          ))
        }
        {!latest && <p>{en ? 'No posts yet.' : '暂时还没有文章。'}</p>}
      </section>
      <aside class="home-aside">
        {
          album && (
            <section aria-labelledby="home-photos-title">
              <div class="home-section-heading">
                <>
                  <h2 id="home-photos-title">{en ? 'Daily Frames' : '日常影像'}</h2>
                  <a href={prefix + '/photos'}>{en ? 'Gallery' : '相册'} ↗</a>
                </>
              </div>
              <a class="home-album" href={`${prefix}/photos#${album.id}`}>
                <Image src={album.photos[0].src} alt="" widths={[300, 520, 760]} sizes="(max-width: 720px) 90vw, 390px" />
                <span>
                  {en ? album.title : album.titleZh}
                  <time datetime={album.date}>{date.format(new Date(album.date))}</time>
                </span>
              </a>
            </section>
          )
        }
        <section aria-labelledby="home-letter-title">
          <div class="home-section-heading"><h2 id="home-letter-title">{en ? 'Letters' : '来信'}</h2></div>
          <p>{en ? 'Have something to share? Write to me.' : '有想交流的事，欢迎写信。'}</p>
          <a class="text-link" href="mailto:1146816430@qq.com">{en ? 'Send a letter' : '给我写信'} ↗</a>
        </section>
      </aside>
    </div>

    {
      featured.length > 0 && (
        <section class="home-projects" aria-labelledby="home-projects-title">
          <div class="home-section-heading">
            <h2 id="home-projects-title">{en ? 'Projects' : '项目'}</h2>
            <a href={prefix + '/projects'}>{en ? 'All projects' : '全部项目'} ↗</a>
          </div>
          <div class="home-project-list">
            {featured.map(({ id, data }) => (
              <a href={`${prefix}/projects/${id}`}>
                <div>
                  <h3>{en ? data.nameEn : data.name}</h3>
                  <p>{en ? data.descriptionEn : data.description}</p>
                </div>
                <span aria-hidden="true">↗</span>
              </a>
            ))}
          </div>
        </section>
      )
    }

    <section class="home-goodbye">
      <h2>{en ? 'You’re welcome to write' : '欢迎来信'}</h2>
      <div class="home-actions">
        <a href="mailto:1146816430@qq.com">{en ? 'Say hello' : '写一封信'} ↗</a><a href="/rss.xml"
          >{en ? 'Subscribe via RSS' : '订阅 RSS'} ↗</a
        >
      </div>
      <div class="home-shortcuts">
        <a href={prefix + '/projects'}>{en ? 'Projects' : '项目'}</a><a href={prefix + '/photos'}>{en ? 'Photos' : '照片'}</a><a
          href={prefix + '/about'}>{en ? 'About' : '关于'}</a
        >
      </div>
    </section>
  </div>
</Layout>
