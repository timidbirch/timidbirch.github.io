<div class="season-background" aria-hidden="true" transition:persist="season-background">
  <canvas></canvas>
</div>

<script>
  function leafShapes() {
    return [
      // Maple, ginkgo, and a narrow curled leaf, in a normalized 32px square.
      new Path2D('M16 1 19 8 23 6 23 12 30 10 28 16 31 18 25 21 23 26 18 25 17 31 15 31 15 25 10 26 8 22 2 20 6 16 3 11 10 12 10 7 14 9Z'),
      new Path2D('M16 29Q15 24 12 21C8 21 7 17 4 16L1 8Q4 4 8 5Q10 1 14 4Q18 0 22 4Q28 3 31 9Q29 15 24 19L17 22 18 29Z'),
      new Path2D('M29 2C18 4 7 6 5 17Q3 22 7 26L3 31 5 32 10 26C22 27 26 15 29 2Z'),
    ]
  }
  const colors = ['#a76140', '#aaa05d', '#7d8751', '#a48243']

  function startBackground() {
    const canvas = document.querySelector<HTMLCanvasElement>('.season-background canvas')
    if (!canvas) return
    if (typeof Path2D === 'undefined') return
    const ctx = canvas.getContext('2d')
    if (!ctx) return
    const leaves = leafShapes()
    const motion = matchMedia('(prefers-reduced-motion: reduce)')
    let width = 0
    let height = 0
    let frame = 0
    let last = 0

    const particles = Array.from({ length: 120 }, (_, index) => ({
      index,
      x: Math.random(),
      y: Math.random(),
      angle: Math.random() * Math.PI * 2,
      spin: (Math.random() - 0.5) * 1.2,
      phase: Math.random() * Math.PI * 2,
      speed: 9 + Math.random() * 19,
      size: index < 36 ? 10 + Math.random() * 19 : 0.45 + Math.random() * 1.25,
    }))

    const draw = (elapsed: number) => {
      ctx.clearRect(0, 0, width, height)
      const dark = document.documentElement.classList.contains('dark')
      const density = width < 600 ? 0.58 : 1
      for (const p of particles) {
        if (p.index % 10 >= density * 10) continue
        const isLeaf = p.index < 36
        p.y += (elapsed * p.speed) / height
        if (p.y > 1.05) p.y = -0.05
        p.phase += elapsed * 0.66
        p.angle += elapsed * p.spin
        const x = p.x * width + Math.sin(p.phase) * (isLeaf ? 32 : 13)
        const y = p.y * height
        ctx.fillStyle = colors[p.index % colors.length]
        ctx.globalAlpha = isLeaf ? (dark ? 0.29 : 0.34) : dark ? 0.19 : 0.29
        if (!isLeaf) {
          ctx.beginPath()
          ctx.arc(x, y, p.size, 0, Math.PI * 2)
          ctx.fill()
          continue
        }
        const scale = p.size / 32
        ctx.save()
        ctx.translate(x, y)
        ctx.rotate(p.angle + 0.32 * Math.sin(p.phase))
        ctx.scale(scale * (0.64 + 0.36 * Math.abs(Math.cos(p.phase))), scale)
        ctx.translate(-16, -16)
        ctx.fill(leaves[p.index % leaves.length])
        ctx.globalAlpha *= 0.47
        ctx.strokeStyle = dark ? '#d1b17d' : '#6a5737'
        ctx.lineWidth = 0.65
        ctx.beginPath()
        ctx.moveTo(16, 25)
        ctx.quadraticCurveTo(17, 16, 19, 9)
        ctx.stroke()
        ctx.restore()
      }
      ctx.globalAlpha = 1
    }

    const tick = (now: number) => {
      draw(last ? Math.min((now - last) / 1000, 0.05) : 0)
      last = now
      frame = requestAnimationFrame(tick)
    }
    const sync = () => {
      cancelAnimationFrame(frame)
      last = 0
      if (document.hidden || document.documentElement.dataset.effects === 'off') return
      if (motion.matches) draw(0)
      else frame = requestAnimationFrame(tick)
    }
    const resize = () => {
      width = canvas.clientWidth
      height = canvas.clientHeight
      if (!width || !height) {
        cancelAnimationFrame(frame)
        return
      }
      const ratio = Math.min(devicePixelRatio, 1.5)
      canvas.width = Math.round(width * ratio)
      canvas.height = Math.round(height * ratio)
      ctx.setTransform(ratio, 0, 0, ratio, 0, 0)
      sync()
    }
    const observer = new ResizeObserver(resize)
    observer.observe(canvas)
    const effects = new MutationObserver(resize)
    effects.observe(document.documentElement, { attributes: true, attributeFilter: ['data-effects'] })
    document.addEventListener('visibilitychange', sync)
    document.addEventListener('site-theme-change', sync)
    motion.addEventListener('change', sync)
  }
  startBackground()
</script>
