---
const particles = Array.from({ length: 45 }, (_, i) => ({
  x: (i * 61 + 11) % 101,
  size: i % 3 === 0 ? 11 + (i % 9) : 2 + (i % 3),
  duration: 27 + (i % 17),
  delay: -((i * 13 + 7) % 42),
  sway: (i % 2 === 0 ? 1 : -1) * (45 + (i % 7) * 12),
  angle: (i * 39) % 360,
}))
---

<div class="season-background" aria-hidden="true" transition:persist="season-background">
  {
    particles.map((p) => (
      <i style={`--x:${p.x}%;--size:${p.size}px;--time:${p.duration}s;--delay:${p.delay}s;--sway:${p.sway}px;--angle:${p.angle}deg`} />
    ))
  }
</div>
