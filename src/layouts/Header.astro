---
import { SITE } from '~/config'
import Avatar from '~/components/space/Avatar.astro'
import ThemeToggle from '~/components/theme/ThemeToggle'
import { BLOG_CATEGORIES } from '~/lib/blog-categories'

const path = Astro.url.pathname.replace(/\/$/, '') || '/'
const en = path === '/en' || path.startsWith('/en/')
const prefix = en ? '/en' : ''
const home = prefix || '/'
const localizedPath = path.replace(/^\/posts(?=\/|$)/, '/blog')
const mirrored = /^\/(?:blog|photos|projects|experience|about)(?:\/|$)/.test(localizedPath)
const languageHref = en ? path.replace(/^\/en(?=\/|$)/, '') || '/' : mirrored ? `/en${localizedPath}` : '/en'
const moreLinks = [
  { path: '/projects', title: en ? 'Projects' : '项目', desc: en ? 'Research and things I’ve built' : '研究与作品' },
  { path: '/photos', title: en ? 'Photos' : '照片', desc: en ? 'An archive of everyday photographs' : '日常影像与相册' },
  { path: '/about', title: en ? 'About' : '关于', desc: en ? 'A little about me' : '关于我和这个站点' },
  { path: '/experience', title: en ? 'Experience' : '实践经历', desc: en ? 'Work and research experience' : '工作与研究经历' },
]
const current = (url: string) => (path === url || path.startsWith(`${url}/`) ? 'page' : undefined)
const moreCurrent = moreLinks.some((link) => link.path !== '/projects' && current(prefix + link.path))
---

<space-navigation class="space-header" transition:name="space-header" transition:animate="none">
  <header class="space-header-inner">
    <a href={home} class="space-brand"><Avatar class="brand-avatar" small />{SITE.title}</a>
    <nav class="space-nav" aria-label={en ? 'Main navigation' : '主导航'}>
      <a href={home} aria-current={path === home ? 'page' : undefined}>{en ? 'Home' : '首页'}</a>
      <details name="site-menu">
        <summary data-current={current(prefix + '/blog')}>{en ? 'Posts' : '文章'}</summary>
        <div class="space-dropdown">
          {BLOG_CATEGORIES.map((category) => <a href={`${prefix}/blog/category/${category.id}`}>{en ? category.nameEn : category.name}</a>)}
          <a class="dropdown-last" href={`${prefix}/blog`}>{en ? 'All posts' : '浏览全部文章'} →</a>
        </div>
      </details>
      <a href={prefix + '/projects'} aria-current={current(prefix + '/projects')} data-astro-prefetch="hover">{en ? 'Projects' : '项目'}</a>
      <details name="site-menu">
        <summary data-current={moreCurrent ? 'page' : undefined}>{en ? 'More' : '更多'}</summary>
        <div class="space-dropdown">
          {
            moreLinks.map((link) => (
              <a href={prefix + link.path} aria-current={current(prefix + link.path)}>
                {link.title}
                <small>{link.desc}</small>
              </a>
            ))
          }
        </div>
      </details>
    </nav>
    <div class="space-tools">
      <a id="language-toggle" href={languageHref} data-language={en ? 'zh' : 'en'} aria-label={en ? '切换为中文' : 'Switch to English'}
        >{en ? '中' : 'EN'}</a
      >
      <ThemeToggle client:load label={en ? 'Change theme' : '切换主题'} />
    </div>
  </header>
</space-navigation>

<script>
  class SpaceNavigation extends HTMLElement {
    controller?: AbortController
    closeTimer?: number
    connectedCallback() {
      this.controller = new AbortController()
      const { signal } = this.controller
      const close = () => this.querySelectorAll('details[open]').forEach((menu) => menu.removeAttribute('open'))
      const desktop = matchMedia('(hover: hover) and (pointer: fine)')
      for (const menu of this.querySelectorAll<HTMLDetailsElement>('details')) {
        menu.addEventListener(
          'pointerenter',
          (event) => {
            if (!desktop.matches || event.pointerType === 'touch') return
            clearTimeout(this.closeTimer)
            menu.open = true
          },
          { signal }
        )
        menu.addEventListener(
          'pointerleave',
          (event) => {
            if (!desktop.matches || event.pointerType === 'touch' || menu.contains(document.activeElement)) return
            this.closeTimer = window.setTimeout(() => {
              menu.open = false
            }, 150)
          },
          { signal }
        )
        menu.addEventListener(
          'focusout',
          (event) => {
            if (event.relatedTarget instanceof Node && !menu.contains(event.relatedTarget) && !menu.matches(':hover')) menu.open = false
          },
          { signal }
        )
        menu.querySelector('summary')?.addEventListener(
          'click',
          (event) => {
            if (event instanceof PointerEvent && event.detail > 0 && desktop.matches && event.pointerType === 'mouse' && menu.open) {
              event.preventDefault()
            }
          },
          { signal }
        )
      }

      document.addEventListener(
        'pointerdown',
        (event) => {
          if (event.target instanceof Node && !this.contains(event.target)) close()
        },
        { signal }
      )
      this.addEventListener(
        'keydown',
        (event) => {
          if (event.key !== 'Escape') return
          this.querySelector<HTMLElement>('details[open] > summary')?.focus()
          close()
        },
        { signal }
      )
      this.querySelector('#language-toggle')?.addEventListener(
        'click',
        (event) => {
          const link = event.currentTarget as HTMLAnchorElement
          try {
            localStorage.setItem('site-language', link.dataset.language || 'zh')
          } catch {}
          link.hash = location.hash
        },
        { signal }
      )
      this.addEventListener(
        'click',
        (event) => {
          if (event.target instanceof Element && event.target.closest('.space-dropdown a')) close()
        },
        { signal }
      )
    }
    disconnectedCallback() {
      clearTimeout(this.closeTimer)
      this.controller?.abort()
    }
  }
  customElements.define('space-navigation', SpaceNavigation)
</script>
