---
import { ANALYTICS_CONFIG } from '~/config'
import ViewCounts from '~/components/base/ViewCounts.astro'
const en = Astro.url.pathname === '/en' || Astro.url.pathname.startsWith('/en/')
---

<footer class="space-footer">
  <div class="space-footer-row">
    <span>© {new Intl.DateTimeFormat('en', { year: 'numeric', timeZone: 'Asia/Hong_Kong' }).format(new Date())} CHEN Peihua</span>
    <div>
      <a href="mailto:1146816430@qq.com">{en ? 'Email' : '邮件'}</a>
      <a href="https://github.com/timidbirch">GitHub</a>
      <a href="/rss.xml">RSS</a>
    </div>
  </div>
  {ANALYTICS_CONFIG.vercount?.enabled && <ViewCounts {en} />}
</footer>
