---
import { render } from 'astro:content'
import Layout from '~/layouts/Layout.astro'
import Prose from '~/components/posts/base/Prose.astro'
import SectionDivider from '~/components/base/SectionDivider.astro'
import { getAllExperiences } from '~/lib/data'

export async function getStaticPaths() {
  const experiences = await getAllExperiences()
  return experiences.map((experience) => ({ params: { id: experience.id }, props: { experience } }))
}

const { experience } = Astro.props
const { Content } = await render(experience)
const meta = experience.data
---

<Layout title={`${meta.role} · ${meta.company}`} description={meta.summary}>
  <article class="relative z-[1]">
    <header class="px-6 sm:px-8 py-10 sm:py-14">
      <a href="/experience" class="inline-flex items-center gap-2 text-sm text-muted-foreground hover:text-foreground mb-10">← 返回实践经历</a>
      <div class="flex flex-wrap gap-3 text-xs uppercase tracking-wide text-muted-foreground mb-4">
        <span>{meta.period}</span>{meta.location && <span>{meta.location}</span>}
      </div>
      <h1 class="text-3xl sm:text-5xl tracking-tight text-balance">{meta.company}</h1>
      {meta.companyEn && <p class="text-muted-foreground mt-2">{meta.companyEn}</p>}
      <p class="text-xl sm:text-2xl mt-6">{meta.role}</p>
      <p class="text-lg text-muted-foreground mt-5 max-w-2xl leading-relaxed text-pretty">{meta.summary}</p>
      <div class="flex flex-wrap gap-2 mt-7">
        {meta.tags.map((tag) => <span class="text-xs px-2.5 py-1 rounded-full bg-tag-bg border border-tag-border text-tag-text">{tag}</span>)}
      </div>
    </header>
    <SectionDivider />
    <div class="px-6 sm:px-8 py-10 sm:py-14"><Prose class="max-w-none"><Content /></Prose></div>
  </article>
</Layout>
