---
import { TAGS_CONFIG } from '~/config'
import Layout from '~/layouts/Layout.astro'
import { getAllTags } from '~/lib/data'
const { title, description, introduce } = TAGS_CONFIG
const tags = Object.entries(await getAllTags()).sort((a, b) => b[1] - a[1])
---
<Layout {title} {description}>
  <section class="paper-list">
    <h1 class="paper-title">{title}</h1>
    <p class="paper-intro">{introduce}</p>
    <div class="paper-chips archive-chapters">
      {tags.map(([tag, count]) => <a href={`/tags/${encodeURIComponent(tag)}`}>#{tag} <small>{count}</small></a>)}
    </div>
  </section>
</Layout>
