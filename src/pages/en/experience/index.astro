---
import Layout from '~/layouts/Layout.astro'
import PageTitle from '~/components/base/PageTitle.astro'
import SectionDivider from '~/components/base/SectionDivider.astro'
import { getAllExperiences } from '~/lib/data'

const experiences = await getAllExperiences()
---

<Layout title="Experience" description="CHEN Peihua's experience across asset management, quantitative research, private equity, and AI engineering.">
  <div class="relative z-[1] py-8 pb-10">
    <div class="px-6 sm:px-8"><PageTitle title="Experience" introduce="Trade execution, investment research, quantitative analysis, and AI engineering." /></div>
    <SectionDivider className="my-8" />
    <div class="border-y border-border/50">
      {experiences.map((experience, index) => (
        <article>
          <a href={`/en/experience/${experience.id}`} class="group grid sm:grid-cols-[10rem_1fr_auto] gap-3 sm:gap-7 px-6 sm:px-8 py-7 hover:bg-muted/30 transition-colors">
            <div><p class="text-sm text-muted-foreground">{experience.data.period}</p><p class="text-sm mt-1">{experience.data.roleEn}</p></div>
            <div>
              <h2 class="text-xl font-semibold tracking-tight group-hover:text-primary transition-colors">{experience.data.companyEn || experience.data.company}</h2>
              <p class="text-muted-foreground leading-relaxed mt-4 max-w-2xl">{experience.data.summaryEn}</p>
              <div class="flex flex-wrap gap-2 mt-4">{experience.data.tagsEn.map((tag) => <span class="text-xs px-2.5 py-1 rounded-full bg-tag-bg border border-tag-border text-tag-text">{tag}</span>)}</div>
            </div>
            <span class="text-muted-foreground group-hover:translate-x-1 group-hover:-translate-y-1 transition-transform">↗</span>
          </a>
          {index < experiences.length - 1 && <SectionDivider />}
        </article>
      ))}
    </div>
  </div>
</Layout>
